{{template "base/head" .}}
{{$s := .Summary}}
<header class="mb-5">
	<h1 class="mb-1 text-2xl font-medium">{{or (index .Settings "site_title") "Финансы cu3rd"}}</h1>
	{{with index .Settings "public_intro"}}<p class="max-w-3xl whitespace-pre-line text-ink-light">{{.}}</p>{{end}}
</header>

<div class="mb-5 grid gap-4 sm:grid-cols-3">
	<div class="box box-body !mb-0">
		<div class="text-xs uppercase tracking-wide text-ink-muted">Расходы в месяц</div>
		<div id="monthly-total" class="stat-value">{{Rub $s.MonthlyTotal}}</div>
		<div class="text-xs text-ink-muted">{{Rub $s.YearlyTotal}} в год · {{$s.ActiveCount}} {{Plural $s.ActiveCount "статья" "статьи" "статей"}}</div>
	</div>
	<div class="box box-body !mb-0">
		<div class="text-xs uppercase tracking-wide text-ink-muted">Донаты за 12 месяцев</div>
		<div class="stat-value">{{Rub $s.Donations12m}}</div>
		<div class="text-xs text-ink-muted">всего {{Rub $s.DonationsTotal}} · спасибо {{$s.DonorsCount}} {{Plural $s.DonorsCount "человеку" "людям" "людям"}}</div>
	</div>
	<div class="box box-body !mb-0">
		<div class="text-xs uppercase tracking-wide text-ink-muted">Покрыто донатами</div>
		<div class="stat-value">{{$s.Coverage}}%</div>
		<div class="bar my-1.5"><div style="width: {{$s.CoveragePercent}}%"></div></div>
		<div class="text-xs text-ink-muted">месячных расходов</div>
	</div>
</div>

<div class="grid items-start gap-5 xl:items-stretch xl:grid-cols-[minmax(0,1fr)_280px_280px]">
	<div class="min-w-0 [&>.box:last-child]:mb-0">
		<div class="box">
			<div class="box-header">На что уходят деньги</div>
			{{if not .Groups}}<p class="p-6 text-center text-ink-muted">Пока пусто.</p>{{else}}
			<div class="overflow-x-auto">
			<table id="public-expenses" class="table">
				<thead><tr><th>Статья</th><th class="!text-right">Стоимость</th><th class="!text-right">В месяц</th><th>Следующая оплата</th></tr></thead>
				{{range .Groups}}
				<tbody>
					<tr class="group-row"><td colspan="3"><strong>{{.Category}}</strong></td><td class="text-right">{{Rub .Monthly}}/мес</td></tr>
					{{range .Rows}}
					<tr>
						<td>
							{{if .Description}}
							<details class="expense-details">
								<summary class="flex cursor-pointer items-baseline gap-1.5 hover:text-white"><span class="chevron text-[10px] text-ink-muted">▶</span><span>{{.Name}}{{if .Provider}} <span class="text-xs text-ink-muted">· {{.Provider}}</span>{{end}}</span></summary>
								<div class="mt-1.5 whitespace-pre-line pl-4 text-xs text-ink-muted">{{.Description}}</div>
							</details>
							{{else}}
							<div class="pl-4">{{.Name}}{{if .Provider}} <span class="text-xs text-ink-muted">· {{.Provider}}</span>{{end}}</div>
							{{end}}
						</td>
						<td class="whitespace-nowrap text-right">{{Money .Amount .Currency}}<span class="text-ink-muted">/{{.PeriodInfo.Short}}</span></td>
						<td class="whitespace-nowrap text-right">{{Rub .Monthly}}</td>
						<td class="whitespace-nowrap">{{template "admin/due" .}}</td>
					</tr>
					{{end}}
				</tbody>
				{{end}}
				<tfoot><tr class="bg-box-header font-semibold"><td class="px-3 py-2">Итого{{if $s.HiddenCount}} <span class="text-xs font-normal text-ink-muted">(вкл. {{$s.HiddenCount}} непубличных)</span>{{end}}</td><td></td><td class="whitespace-nowrap px-3 py-2 text-right">{{Rub $s.MonthlyTotal}}</td><td></td></tr></tfoot>
			</table>
			</div>
			{{end}}
		</div>

		{{if $s.ByCategory}}
		<div class="box">
			<div class="box-header">По категориям</div>
			<div class="box-body">
				{{range $s.ByCategory}}
				<div class="grid grid-cols-[1fr_auto] items-center gap-x-3 gap-y-1 py-1.5 sm:grid-cols-[160px_1fr_auto]">
					<div>{{.Name}} <span class="text-xs text-ink-muted">· {{.Count}}</span></div>
					<div class="bar col-span-2 row-start-2 sm:col-span-1 sm:row-start-auto"><div style="width: {{.Share $s.MonthlyTotal}}%"></div></div>
					<div class="whitespace-nowrap text-right">{{Rub .Monthly}}/мес</div>
				</div>
				{{end}}
			</div>
		</div>
		{{end}}
	</div>

	<aside class="min-w-0">
		<div class="box !mb-0 xl:h-full">
			<div class="box-header">Поддержать</div>
			<div class="box-body whitespace-pre-line">{{index .Settings "donate_text"}}</div>
			{{if .CryptoBot}}
			<form id="donate-form" class="box-body border-t border-line" method="post" action="{{AppSubURL}}/donate" hx-post="{{AppSubURL}}/donate">
				<div class="field"><label for="d-amount">Сумма, ₽</label><input id="d-amount" name="amount" inputmode="decimal" required placeholder="500" data-funny="{{.FunnyAmounts}}"></div>
				<div class="field"><label for="d-donor">Имя</label><input id="d-donor" name="donor" maxlength="100" placeholder="пусто — анонимно"></div>
				<div class="field"><label for="d-message">Сообщение</label><textarea id="d-message" name="message" rows="2" maxlength="500"></textarea></div>
				<button class="btn btn-primary w-full" type="submit">Оплатить через Crypto Bot</button>
				<p class="mt-2 text-xs text-ink-muted">Сумма в рублях, платить можно любой криптовалютой в Telegram.</p>
			</form>
			{{end}}
		</div>
	</aside>

	<aside class="min-w-0 xl:relative xl:self-stretch">
		<div class="box !mb-0 flex min-h-0 flex-col xl:absolute xl:inset-0">
			<div class="box-header">Донаты <span class="label">{{len .Donations}}</span></div>
			{{if not .Donations}}<p class="p-6 text-center text-ink-muted">Пока никто не задонатил — будьте первым.</p>{{end}}
			<div class="min-h-0 max-h-96 overflow-y-auto xl:max-h-none">
				{{template "admin/donation_feed" dict "Donations" .Donations "Admin" false}}
			</div>
		</div>
	</aside>
</div>
{{template "base/footer" .}}
