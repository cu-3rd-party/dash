{{template "base/head" .}}
<div class="grid items-start gap-5 lg:grid-cols-[minmax(0,1fr)_320px]">
	<div class="box min-w-0">
		<div class="overflow-x-auto">
		<table id="categories" class="table">
			<thead><tr><th>Категория</th><th>Код</th><th>Порядок</th><th>Статей</th></tr></thead>
			<tbody>
			{{range .Categories}}
			{{if $.Doer.Can "editor"}}
			<tr>
				<td colspan="4">
					<form class="flex flex-wrap items-center gap-1.5" method="post" action="{{AppSubURL}}/admin/categories/{{.ID}}" hx-post="{{AppSubURL}}/admin/categories/{{.ID}}">
						<input class="!w-auto flex-1 basis-36" name="name" value="{{.Name}}" aria-label="Название" required>
						<input class="!w-28 font-mono" name="slug" value="{{.Slug}}" aria-label="Код" required>
						<input class="!w-20" name="sort_order" type="number" value="{{.SortOrder}}" aria-label="Порядок">
						<input class="!w-auto flex-1 basis-36" name="description" value="{{.Description}}" placeholder="описание" aria-label="Описание">
						<a class="label label-basic" href="{{AppSubURL}}/admin/expenses?cat={{.ID}}&amp;status=all" title="статей в категории">{{.ExpenseCount}}</a>
						<button class="btn btn-secondary btn-sm" type="submit">Сохранить</button>
						<button class="btn btn-danger btn-sm" type="submit" formaction="{{AppSubURL}}/admin/categories/{{.ID}}/delete" hx-post="{{AppSubURL}}/admin/categories/{{.ID}}/delete" hx-confirm="Удалить категорию «{{.Name}}»?" {{if .ExpenseCount}}disabled title="в категории есть статьи"{{end}}>Удалить</button>
					</form>
				</td>
			</tr>
			{{else}}
			<tr><td>{{.Name}}<div class="text-xs text-ink-muted">{{.Description}}</div></td><td class="font-mono">{{.Slug}}</td><td>{{.SortOrder}}</td><td><a href="{{AppSubURL}}/admin/expenses?cat={{.ID}}&amp;status=all">{{.ExpenseCount}}</a></td></tr>
			{{end}}
			{{end}}
			</tbody>
		</table>
		</div>
	</div>
	{{if .Doer.Can "editor"}}
	<aside class="box min-w-0">
		<div class="box-header">Новая категория</div>
		<form id="category-form" class="box-body" method="post" action="{{AppSubURL}}/admin/categories" hx-post="{{AppSubURL}}/admin/categories">
			<div class="field"><label for="c-name">Название</label><input id="c-name" name="name" placeholder="Подписки / SaaS" required></div>
			<div class="grid grid-cols-2 gap-x-3">
				<div class="field"><label for="c-slug">Код</label><input id="c-slug" class="font-mono" name="slug" placeholder="saas" required></div>
				<div class="field"><label for="c-sort">Порядок</label><input id="c-sort" name="sort_order" type="number" value="30"></div>
			</div>
			<div class="field"><label for="c-desc">Описание</label><input id="c-desc" name="description"></div>
			<button class="btn btn-primary w-full" type="submit">Создать</button>
		</form>
	</aside>
	{{end}}
</div>
{{template "base/footer" .}}
