{{template "base/head" .}}
<div class="box max-w-lg">
	<div class="box-header">Профиль · {{.Doer.Login}}</div>
	<form class="box-body" method="post" action="{{AppSubURL}}/admin/profile" hx-post="{{AppSubURL}}/admin/profile">
		<div class="field">
			<label for="telegram">Контактный Telegram</label>
			<input id="telegram" class="font-mono" name="telegram" value="{{.Doer.Telegram}}" placeholder="{{.Doer.Login}}" autocomplete="off">
			<p class="help">Показывается на публичной странице в блоке «Поддержать». Пусто — совпадает с логином Forgejo (@{{.Doer.Login}}).</p>
		</div>
		<button class="btn btn-primary" type="submit">Сохранить</button>
	</form>
</div>
{{template "base/footer" .}}
