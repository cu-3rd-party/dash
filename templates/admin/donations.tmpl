{{template "base/head" .}}
<div class="grid items-start gap-5 lg:grid-cols-[minmax(0,1fr)_320px]">
	<div class="min-w-0">
		<div class="mb-3 flex flex-wrap justify-between gap-2 text-ink-muted">
			<span>Поступления</span>
			<span>{{len .Donations}} {{Plural (len .Donations) "донат" "доната" "донатов"}} · всего ≈ <strong class="text-success-fg">{{Rub .Total}}</strong></span>
		</div>
		<div class="box">
			{{if not .Donations}}<p class="p-6 text-center text-ink-muted">Донатов пока нет.</p>{{else}}
			<div class="overflow-x-auto">
			<table id="donations" class="table">
				<thead><tr><th>Дата</th><th>От кого</th><th class="!text-right">Сумма</th><th>Источник</th><th>Сообщение</th>{{if .Doer.Can "editor"}}<th></th>{{end}}</tr></thead>
				<tbody>
				{{range .Donations}}
				<tr>
					<td class="whitespace-nowrap">{{Date .DonatedOn}}</td>
					<td>{{if .Donor}}{{.Donor}}{{else}}<span class="text-ink-muted">Аноним</span>{{end}}{{if not .IsPublic}} <span class="label label-basic" title="не показывается на публичной странице">скрыт</span>{{end}}</td>
					<td class="whitespace-nowrap text-right text-success-fg">+{{Money .Amount .Currency}}</td>
					<td><span class="label label-basic">{{.Source}}</span>{{if .ExternalID}} <span class="font-mono text-xs text-ink-muted" title="external_id">{{.ExternalID}}</span>{{end}}</td>
					<td class="whitespace-pre-line text-[13px]">{{.Message}}</td>
					{{if $.Doer.Can "editor"}}<td class="text-right"><a class="text-xs text-ink-muted hover:text-ink" href="{{AppSubURL}}/admin/donations/{{.ID}}/edit">изменить</a></td>{{end}}
				</tr>
				{{end}}
				</tbody>
			</table>
			</div>
			{{end}}
		</div>
	</div>

	<aside class="min-w-0">
		{{if .Doer.Can "editor"}}
		<div class="box">
			<div class="box-header">Добавить донат вручную</div>
			<form id="donation-form" class="box-body" method="post" action="{{AppSubURL}}/admin/donations" hx-post="{{AppSubURL}}/admin/donations">
				{{template "admin/donation_fields" dict "Donor" "" "Anonymous" false "Amount" "" "Currency" "RUB" "Date" .Today "Source" "manual" "Message" "" "Public" true}}
				<button class="btn btn-primary w-full" type="submit">Добавить</button>
			</form>
		</div>
		{{end}}
		<div class="box">
			<div class="box-header">Автоматический приём</div>
			<div class="box-body text-[13px]">
				{{if .WebhookEnabled}}
				<p class="mb-2"><span class="label status-ok">включён</span> Провайдер (или скрипт-адаптер) шлёт донаты сюда:</p>
				{{else}}
				<p class="mb-2"><span class="label">выключен</span> Задайте <code>DASH_DONATION_WEBHOOK_TOKEN</code>, чтобы принимать донаты автоматически:</p>
				{{end}}
<pre class="mb-2 overflow-x-auto rounded-box border border-line bg-code p-2 font-mono text-xs">POST {{.BaseURL}}/api/donations
Authorization: Bearer $TOKEN

{"source": "boosty", "external_id": "tx-123",
 "donor": "Вася", "anonymous": false,
 "amount": 500, "currency": "RUB",
 "donated_at": "2026-11-10T12:00:00Z",
 "message": "спасибо!"}</pre>
				<p class="text-ink-muted">Повтор с теми же <code>source</code> и <code>external_id</code> не создаёт дубль.</p>
			</div>
		</div>
	</aside>
</div>
{{template "base/footer" .}}
